# Kernel configuration for wayne (Xiaomi MI 6X, SDM660), format 2.
#
# Archive builders and component recipes come from [kernel] archives in
# board.toml; this file only carries the switches.

CONFIG_XNU_BUILD_ARCHIVES=y
CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_SOURCE_MOCKFS=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_NATIVE_AES=y
CONFIG_XNU_NATIVE_ARCH_TIMER=y
CONFIG_XNU_TRUST_CACHE_RUNTIME=y
CONFIG_XNU_NATIVE_CS_HASH_CACHE=y
CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"
# Without this the base tree maps PLATFORM_PANIC_LOG_PADDR (0x3c0f0000) and
# reads it, which is an unmapped window on SDM660: console init hangs there.
CONFIG_XNU_DT_PANIC_REGION=y

# Kryo 260 is ARMv8.0-A: PSTATE.PAN is not implemented.
CONFIG_XNU_NATIVE_PAN=n

# Platform power: AMFI waits for an ApplePMGRNub and panics "AMFI: No PMGR?"
# without one. scripts/build-clover-pmgr.py writes the archive the base build
# force-loads under that name.
# Not selected yet: no native storage, GPU or display driver.
CONFIG_XNU_ARMVIRT_PLATFORM=n
CONFIG_XNU_BOOT_PROGRESS=n
CONFIG_XNU_NATIVE_UFS=n
CONFIG_XNU_NATIVE_ADRENO=n
CONFIG_XNU_NATIVE_MOBILE_DISPLAY=n
CONFIG_XNU_SHENG_PMGR=y
# The PMGR nub calls the board eMMC/input/power/DSP entry points; they are empty
# until those drivers are ported, and a missing symbol fails the kernel link.
CONFIG_XNU_EXTRA_LD_ARCHIVES="{tree}/build/wayne-board-stubs/libWayneBoardStubs.a"

CONFIG_XNU_EXTRA_CFLAGS="-Wno-reserved-identifier -Wno-pre-c11-compat -Wno-missing-designated-field-initializers -Wno-suggest-override -Wno-suggest-destructor-override -Wno-ms-bitfield-padding"
